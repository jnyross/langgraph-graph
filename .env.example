# Copy to .env and fill in. Never commit .env.

# Any OpenAI-compatible endpoint. Defaults target local Ollama.
MODEL=ollama/chatgpt-oss:latest
BASE_URL=http://localhost:11434/v1
API_KEY=ollama

# Optional: LiteLLM gateway URL instead of direct provider
# BASE_URL=http://localhost:4000/v1

# LangGraph checkpointer DB
CHECKPOINTER_DB=checkpoints.sqlite

# Set to 1 to enable debug logging
LANGGRAPH_GRAPH_DEBUG=0

# LangSmith / Studio (optional for local dev; enables traces)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=langgraph-graph


# Meta legal research graph (OpenRouter)
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Rolling latest Flash alias (API id). Currently -> deepseek/deepseek-v4-flash-0731
# Pin instead: deepseek/deepseek-v4-flash-0731  |  older: deepseek/deepseek-v4-flash
OPENROUTER_MODEL=~deepseek/deepseek-v4-flash-latest
# Optional: TAVILY_API_KEY=  (if using Tavily instead of DDG)
DOSSIER_ROOT=data/dossiers
# Local Firecrawl scrape (self-hosted) + cloud CLI search fallback order
FIRECRAWL_API_URL=http://localhost:3002
META_LEGAL_FETCH_BACKEND=auto
META_LEGAL_FIRECRAWL_MAX_PAR=20
META_LEGAL_FIRECRAWL_SEARCH_MAX_PAR=12


# Full-grid parallel workers (examples/meta_legal_full_grid.py)
META_LEGAL_MAX_CONCURRENCY=100